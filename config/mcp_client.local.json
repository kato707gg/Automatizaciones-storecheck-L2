{
  "client_factory": "core.creador_de_tareas.mcp_client_template:create_mcp_client",
  "server_command": [
    "C:/Program Files/nodejs/npx.cmd",
    "-y",
    "chrome-devtools-mcp",
    "--no-usage-statistics"
  ],
  "browser_url": "auto",
  "startup_url": "https://webapp.storecheck.com/",
  "debug_ports": [9222, 9223, 9333, 9444],
  "auto_launch_browser": true,
  "use_temp_profile_on_launch": true,
  "use_persistent_profile_on_launch": false,
  "keep_browser_open_on_close": false,
  "tool_evaluate": "evaluate_script",
  "tool_list_requests": "list_network_requests",
  "tool_get_request": "get_network_request",
  "request_timeout_seconds": 20,
  "init_timeout_seconds": 60
}
